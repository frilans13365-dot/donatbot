import aiohttp
from config import config


async def create_invoice(order_id: str, amount: float, wallet: str, user_id: int) -> dict:
    url = "https://api.paymento.io/v1/invoice"
    headers = {
        "Authorization": f"Bearer {config.PAYMENTO_API_KEY}",
        "Content-Type": "application/json"
    }
    payload = {
        "amount": amount,
        "currency": "USDT",
        "order_id": order_id,
        "webhook_url": f"{config.BASE_URL}/payment-webhook",
        "description": f"DONAT from user {user_id}",
    }
    async with aiohttp.ClientSession() as session:
        async with session.post(url, headers=headers, json=payload) as resp:
            if resp.status == 200:
                return await resp.json()
            text = await resp.text()
            raise Exception(f"Paymento error: {resp.status} {text}")


