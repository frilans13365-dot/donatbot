BOT_TOKEN=1234567890:ABCdefGHIJKLMNopqRsTUVwxyz

# Paymento API (получите в личном кабинете)
PAYMENTO_API_KEY=your_api_key_here
PAYMENTO_WEBHOOK_SECRET=your_webhook_secret_here

